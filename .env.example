# ============================================
# HANES MES - 루트 환경변수 예시
#
# DB 접속 설정의 단일 출처는 apps/backend/.env(.env.local 우선) 다.
# 앱 런타임·마이그레이션 CLI·시드·ERD 생성기가 모두 그 파일을 읽는다.
#   - TypeScript: apps/backend/src/database/oracle-env.ts
#   - Python    : tools/hanes_db.py
# ============================================

# Oracle Database Configuration
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=your-oracle-user
ORACLE_PASSWORD=your-oracle-password
# ORACLE_SID 가 설정되면 SID 로, 없으면 ORACLE_SERVICE_NAME 으로 접속한다.
ORACLE_SERVICE_NAME=JSHNSMES
# ORACLE_SID=

# Oracle Client (optional - for Thick mode)
# ORACLE_CLIENT_LIB=C:\oracle\instantclient_21_12

# Backend
PORT=3003
NODE_ENV=development

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
