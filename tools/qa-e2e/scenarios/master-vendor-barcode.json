{
  "id": "master-vendor-barcode",
  "title": "제조사 바코드 매핑",
  "menuLabel": "제조사 바코드 매핑 (/master/vendor-barcode)",
  "route": "/master/vendor-barcode",
  "testData": {
    "prefix": "FECRUD",
    "primaryKey": "vendorBarcode",
    "values": {
      "vendorBarcode": "{{prefix}}-{{stamp}}",
      "itemCode": "{{prefix}}ITEM-{{stamp}}",
      "itemName": "QA품명-{{stamp}}",
      "vendorCode": "{{prefix}}V",
      "vendorName": "QA제조사-{{stamp}}",
      "mappingRule": "RULE-{{stamp}}",
      "editedName": "QA품명수정-{{stamp}}"
    }
  },
  "openButton": "매핑 추가",
  "submitButton": "추가",
  "editSubmitButton": "수정",
  "cancelButton": "취소",
  "search": { "placeholderIncludes": "검색", "value": "{{vendorBarcode}}" },
  "cleanup": {
    "searchPath": "/master/vendor-barcode-mappings?search={{prefix}}&limit=200",
    "deletePath": "/master/vendor-barcode-mappings/{{vendorBarcode}}",
    "listPath": "data",
    "prefixField": "vendorBarcode",
    "deleteValueField": "vendorBarcode"
  },
  "apiVerify": {
    "searchPath": "/master/vendor-barcode-mappings?search={{vendorBarcode}}&limit=20",
    "listPath": "data",
    "matchField": "vendorBarcode",
    "matchValue": "{{vendorBarcode}}"
  },
  "cases": [
    {
      "id": "load",
      "type": "load",
      "title": "화면 로드",
      "expectSummary": "제조사 바코드 매핑 목록 화면이 정상 렌더링되어야 한다",
      "expect": { "visibleText": "제조사 바코드 매핑" }
    },
    {
      "id": "create-required",
      "type": "create-invalid",
      "title": "비정상: 필수값(제조사 바코드) 누락 검증",
      "expectSummary": "제조사 바코드를 비우고 품번만 입력하면 제출(추가) 버튼이 비활성이어야 한다",
      "fields": [
        { "label": "품번", "value": "{{itemCode}}" }
      ],
      "expect": { "submitDisabled": true }
    },
    {
      "id": "create-valid",
      "type": "create",
      "title": "정상: 신규 바코드 매핑 등록",
      "expectSummary": "필수값을 채우면 등록되고 검색 결과에 제조사 바코드가 노출되어야 한다",
      "fields": [
        { "label": "제조사 바코드", "value": "{{vendorBarcode}}" },
        { "label": "품번", "value": "{{itemCode}}" },
        { "label": "품명", "value": "{{itemName}}" },
        { "label": "제조사 코드", "value": "{{vendorCode}}" },
        { "label": "제조사명", "value": "{{vendorName}}" },
        { "label": "매핑 규칙", "value": "{{mappingRule}}" }
      ],
      "expect": { "rowText": "{{vendorBarcode}}" }
    },
    {
      "id": "create-duplicate",
      "type": "create-duplicate",
      "title": "비정상(RED): 동일 제조사 바코드 중복 등록",
      "expectSummary": "이미 존재하는 제조사 바코드로 등록 시 409 응답 + 오류 모달이 표시되어야 한다",
      "fields": [
        { "label": "제조사 바코드", "value": "{{vendorBarcode}}" },
        { "label": "품번", "value": "{{itemCode}}" },
        { "label": "품명", "value": "{{itemName}}-중복" }
      ],
      "closeButton": "닫기",
      "expect": { "modalText": "오류가 발생했습니다", "httpStatus": 409 }
    },
    {
      "id": "update",
      "type": "update",
      "title": "정상: 품명 수정",
      "expectSummary": "행 수정으로 품명을 변경하면 검색 결과에 변경된 품명이 노출되어야 한다",
      "rowActionIndex": 0,
      "fields": [
        { "label": "품명", "value": "{{editedName}}" }
      ],
      "expect": { "rowText": "{{editedName}}" }
    },
    {
      "id": "delete",
      "type": "delete",
      "title": "정상: 바코드 매핑 삭제",
      "expectSummary": "삭제 확인 모달에서 확인하면 행이 제거되어야 한다",
      "rowActionIndex": 1,
      "confirmButton": "확인"
    },
    {
      "id": "api-verify",
      "type": "api-verify",
      "title": "정리 검증: API 조회 시 임시 매핑 부재",
      "expectSummary": "삭제 후 API 조회 결과에 임시 제조사 바코드가 존재하지 않아야 한다"
    }
  ]
}
