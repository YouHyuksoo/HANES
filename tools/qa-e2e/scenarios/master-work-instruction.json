{
  "id": "master-work-instruction",
  "title": "작업지도서",
  "menuLabel": "작업지도서 관리 (/master/work-instruction)",
  "route": "/master/work-instruction",
  "testData": {
    "prefix": "FECRUD",
    "primaryKey": "itemCode",
    "values": {
      "itemCode": "{{prefix}}-{{stamp}}",
      "processCode": "QAPROC",
      "revision": "A",
      "title": "QA작업지도서-{{stamp}}",
      "editedTitle": "QA작업지도서수정-{{stamp}}",
      "content": "QA 자동화 작업 지침 내용"
    }
  },
  "openButton": "작업지도서 추가",
  "submitButton": "추가",
  "editSubmitButton": "수정",
  "cancelButton": "취소",
  "search": { "placeholderIncludes": "검색", "value": "{{itemCode}}" },
  "cleanup": {
    "searchPath": "/master/work-instructions?search={{prefix}}&limit=200",
    "deletePath": "/master/work-instructions/{{itemCode}}::{{processCode}}::{{revision}}",
    "listPath": "data",
    "prefixField": "itemCode",
    "deleteValueField": "itemCode"
  },
  "apiVerify": {
    "searchPath": "/master/work-instructions?search={{itemCode}}&limit=20",
    "listPath": "data",
    "matchField": "itemCode",
    "matchValue": "{{itemCode}}"
  },
  "cases": [
    {
      "id": "load",
      "type": "load",
      "title": "화면 로드",
      "expectSummary": "작업지도서 관리 화면이 정상 렌더링되어야 한다",
      "expect": { "visibleText": "작업지도서" }
    },
    {
      "id": "create-required",
      "type": "create-invalid",
      "title": "비정상: 필수값(공정코드·문서명) 누락 검증",
      "expectSummary": "품목코드만 입력하고 공정코드/문서명을 비우면 추가 버튼이 비활성이어야 한다",
      "fields": [
        { "label": "품목코드", "value": "{{itemCode}}" }
      ],
      "expect": { "submitDisabled": true }
    },
    {
      "id": "create-valid",
      "type": "create",
      "title": "정상: 신규 작업지도서 등록",
      "expectSummary": "필수값(품목코드·공정코드·문서명)을 모두 채우면 등록되고 검색 결과에 품목코드가 노출되어야 한다",
      "fields": [
        { "label": "품목코드", "value": "{{itemCode}}" },
        { "label": "공정코드", "value": "{{processCode}}" },
        { "label": "문서명", "value": "{{title}}" }
      ],
      "expect": { "rowText": "{{itemCode}}" }
    },
    {
      "id": "create-duplicate",
      "type": "create-duplicate",
      "title": "비정상(RED): 동일 키(품목·공정·리비전) 중복 등록",
      "expectSummary": "이미 존재하는 품목/공정/리비전으로 등록 시 409 응답 + 오류 모달이 표시되어야 한다",
      "fields": [
        { "label": "품목코드", "value": "{{itemCode}}" },
        { "label": "공정코드", "value": "{{processCode}}" },
        { "label": "문서명", "value": "{{title}}-중복" }
      ],
      "expect": { "modalText": "오류가 발생했습니다", "httpStatus": 409 }
    },
    {
      "id": "update",
      "type": "update",
      "title": "정상: 문서명 수정",
      "expectSummary": "행 편집으로 문서명을 변경하면 검색 결과에 변경된 문서명이 노출되어야 한다",
      "rowActionIndex": 0,
      "fields": [
        { "label": "문서명", "value": "{{editedTitle}}" }
      ],
      "expect": { "rowText": "{{editedTitle}}" }
    },
    {
      "id": "delete",
      "type": "delete",
      "title": "정상: 작업지도서 삭제",
      "expectSummary": "삭제 확인 모달에서 확인하면 행이 제거되어야 한다",
      "rowActionIndex": 1,
      "confirmButton": "삭제"
    },
    {
      "id": "api-verify",
      "type": "api-verify",
      "title": "정리 검증: API 조회 시 임시 작업지도서 부재",
      "expectSummary": "삭제 후 API 조회 결과에 임시 품목코드의 작업지도서가 존재하지 않아야 한다"
    }
  ]
}
