{
  "id": "master-partner",
  "title": "거래처관리",
  "menuLabel": "거래처관리 (/master/partner)",
  "route": "/master/partner",
  "testData": {
    "prefix": "FECRUD",
    "primaryKey": "partnerCode",
    "values": {
      "partnerCode": "{{prefix}}-{{stamp}}",
      "partnerName": "QA거래처-{{stamp}}",
      "bizNo": "{{prefix}}-{{stamp}}",
      "ceoName": "QA대표-{{stamp}}",
      "contactPerson": "QA담당-{{stamp}}",
      "editedName": "QA거래처수정-{{stamp}}"
    }
  },
  "openButton": "거래처 추가",
  "submitButton": "추가",
  "editSubmitButton": "수정",
  "cancelButton": "취소",
  "search": { "placeholderIncludes": "검색", "value": "{{partnerCode}}" },
  "cleanup": {
    "searchPath": "/master/partners?search={{prefix}}&limit=200",
    "deletePath": "/master/partners/{{partnerCode}}",
    "listPath": "data",
    "prefixField": "partnerCode",
    "deleteValueField": "partnerCode"
  },
  "apiVerify": {
    "searchPath": "/master/partners?search={{partnerCode}}&limit=20",
    "listPath": "data",
    "matchField": "partnerCode",
    "matchValue": "{{partnerCode}}"
  },
  "cases": [
    {
      "id": "load",
      "type": "load",
      "title": "화면 로드",
      "expectSummary": "거래처관리 목록 화면이 정상 렌더링되어야 한다",
      "expect": { "visibleText": "거래처관리" }
    },
    {
      "id": "create-required",
      "type": "create-invalid",
      "title": "비정상: 필수값(거래처명) 누락 검증",
      "expectSummary": "거래처코드만 입력하고 거래처명을 비우면 제출(추가) 버튼이 비활성이어야 한다",
      "fields": [
        { "label": "거래처코드", "value": "{{partnerCode}}" }
      ],
      "expect": { "submitDisabled": true }
    },
    {
      "id": "create-valid",
      "type": "create",
      "title": "정상: 신규 거래처 등록",
      "expectSummary": "필수값(거래처코드·거래처명)을 채우면 등록되고 검색 결과에 거래처코드가 노출되어야 한다",
      "fields": [
        { "label": "거래처코드", "value": "{{partnerCode}}" },
        { "label": "거래처명", "value": "{{partnerName}}" },
        { "label": "사업자번호", "value": "{{bizNo}}" },
        { "label": "대표자", "value": "{{ceoName}}" },
        { "label": "담당자", "value": "{{contactPerson}}" }
      ],
      "expect": { "rowText": "{{partnerCode}}" }
    },
    {
      "id": "create-duplicate",
      "type": "create-duplicate",
      "title": "비정상(RED): 동일 거래처코드 중복 등록",
      "expectSummary": "이미 존재하는 거래처코드로 등록 시 409 응답 + 오류 모달이 표시되어야 한다",
      "fields": [
        { "label": "거래처코드", "value": "{{partnerCode}}" },
        { "label": "거래처명", "value": "{{partnerName}}-중복" }
      ],
      "closeButton": "닫기",
      "expect": { "modalText": "오류가 발생했습니다", "httpStatus": 409 }
    },
    {
      "id": "update",
      "type": "update",
      "title": "정상: 거래처명 수정",
      "expectSummary": "행 수정으로 거래처명을 변경하면 검색 결과에 변경된 이름이 노출되어야 한다",
      "rowActionIndex": 0,
      "fields": [
        { "label": "거래처명", "value": "{{editedName}}" }
      ],
      "expect": { "rowText": "{{editedName}}" }
    },
    {
      "id": "delete",
      "type": "delete",
      "title": "정상: 거래처 삭제",
      "expectSummary": "삭제 확인 모달에서 확인하면 행이 제거되어야 한다",
      "rowActionIndex": 1,
      "confirmButton": "확인"
    },
    {
      "id": "api-verify",
      "type": "api-verify",
      "title": "정리 검증: API 조회 시 임시 거래처 부재",
      "expectSummary": "삭제 후 API 조회 결과에 임시 거래처코드가 존재하지 않아야 한다"
    }
  ]
}
