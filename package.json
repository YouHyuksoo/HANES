{
  "name": "harness-mes",
  "version": "0.1.0",
  "private": true,
  "description": "HARNESS MES - Manufacturing Execution System for Wire Harness Production",
  "scripts": {
    "dev": "turbo dev",
    "kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev.ps1",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev.ps1 && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:backend": "pnpm --dir apps/backend exec jest --runInBand",
    "test:backend:ci": "pnpm --dir apps/backend exec jest --runInBand --detectOpenHandles",
    "test:frontend:e2e": "pnpm --dir apps/frontend test:e2e",
    "code-map:generate": "node tools/code-map/src/generate.mjs",
    "code-map:test": "node --test tools/code-map/tests/*.test.mjs",
    "typecheck:backend": "pnpm --filter @harness/backend exec tsc --noEmit --pretty false",
    "typecheck:frontend": "pnpm --filter @harness/frontend exec tsc --noEmit --pretty false",
    "verify": "pnpm run test:backend:ci && pnpm run typecheck:backend && pnpm run typecheck:frontend",
    "clean": "turbo clean && rimraf node_modules",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:pull": "turbo db:pull",
    "db:seed": "turbo db:seed"
  },
  "devDependencies": {
    "docx": "^9.6.1",
    "fast-glob": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-morph": "^28.0.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
