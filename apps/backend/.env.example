# ============================================================================
# HARNESS MES Backend 환경변수 설정
# ============================================================================
# 이 파일을 .env로 복사하여 실제 값으로 변경하세요.
# .env 파일은 절대 Git에 커밋하지 마세요!
# ============================================================================

# =========================
# 애플리케이션 설정
# =========================
NODE_ENV=development
PORT=3003
API_PREFIX=api/v1

# =========================
# 데이터베이스 설정 (Oracle) — 단일 출처
# =========================
# 이 파일(.env)이 DB 접속의 유일한 수정 지점이다. 바꾸고 재시작하면 아래가 모두 따라간다.
#   런타임 TypeORM / oracledb 풀 / 마이그레이션 CLI / 시드 / 연결테스트 → src/database/oracle-env.ts
#   ERD 생성기·파이썬 스크립트                                      → tools/hanes_db.py
# 값이 비어 있으면 임의 기본값으로 다른 DB에 붙지 않고 즉시 실패한다.
ORACLE_HOST=your-oracle-host
ORACLE_PORT=1521
ORACLE_USER=your-oracle-user
ORACLE_PASSWORD=your-oracle-password
# ORACLE_SID 가 설정되면 SID 로, 없으면 ORACLE_SERVICE_NAME 으로 접속한다.
ORACLE_SERVICE_NAME=JSHNSMES
# ORACLE_SID=

# =========================
# JWT 인증 설정
# =========================
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# CORS 설정
# =========================
# 여러 origin은 쉼표로 구분
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
